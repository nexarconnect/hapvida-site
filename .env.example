# Configuração do Supabase — copie para `.env` e preencha com os valores reais.
#
#   cp .env.example .env
#
# ATENÇÃO: o sync-prices.js NÃO usa dotenv — criar o .env sozinho não basta.
# Rode com a flag nativa do Node (v20.6+; aqui é v24.16):
#
#   node --env-file=.env scripts/sync-prices.js --dry
#
# Onde pegar: supabase.com → projeto `lnfwneozblwrfmqezeqr` → Settings → API
# (verificado em 2026-08-04: este projeto está ATIVO — não é preciso criar outro)
#
# O `.env` está no .gitignore e não deve ser commitado.


# ── Usado pelo site (build do Vite) ──────────────────────────────────────────
# Sem estas duas, `src/lib/supabase.js` exporta `supabase = null` em silêncio:
# o build passa, mas o site fica sem dados (preços, rede credenciada, leads).

VITE_SUPABASE_URL=https://lnfwneozblwrfmqezeqr.supabase.co
VITE_SUPABASE_ANON_KEY=


# ── Usado só pelo scripts/sync-prices.js ─────────────────────────────────────
# ATENÇÃO: a service_role ignora RLS e tem acesso total ao banco.
# Ela é necessária porque o sync grava em `pricing_table`.
# Mantenha apenas no .env local — nunca no build do front-end, nunca no git.

SUPABASE_service_role=
